# ─── NutriDesk Web — Environment Variables ───────────────────────────────────
# Vercel: add these in Project Settings → Environment Variables
# Local: copy to .env.local

# Supabase (get from supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API URL (your Railway deployment URL in production)
# Development: http://localhost:3001
# Production:  https://your-api.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3001
