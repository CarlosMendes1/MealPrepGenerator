# ─── NutriDesk API — Environment Variables ───────────────────────────────────
# Copy to .env (development) or inject as CI secrets (production).
# Never commit .env files containing real keys.

# ── Required ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe (use test keys in .env, live keys in production CI secrets) ────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...
STRIPE_PRICE_AI_COACH_MONTHLY=price_...
STRIPE_PRICE_AI_COACH_ANNUAL=price_...

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
