# ─── NutriDesk Mobile — Environment Variables ────────────────────────────────
# Copy to .env.local for local development.
# For EAS builds, configure env vars in eas.json or the Expo dashboard.

# Supabase (public — safe to expose in client bundle)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API base URL
# Development (iOS simulator): http://localhost:3001
# Development (Android emulator): http://10.0.2.2:3001
# Production: https://api.nutridesk.app
EXPO_PUBLIC_API_URL=http://localhost:3001
