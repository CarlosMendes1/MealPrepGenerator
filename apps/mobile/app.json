{
  "expo": {
    "name": "NutriDesk",
    "slug": "nutridesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nutridesk",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutridesk.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Necessário para fotografar as suas refeições.",
        "NSPhotoLibraryUsageDescription": "Necessário para selecionar fotos das suas refeições."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5"
      },
      "package": "com.nutridesk.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "INTERNET", "RECEIVE_BOOT_COMPLETED", "SCHEDULE_EXACT_ALARM", "USE_EXACT_ALARM"],
      "minSdkVersion": 21
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4f46e5",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Necessário para selecionar fotos das suas refeições."
        }
      ]
    ],
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "extra": {}

  }
}
