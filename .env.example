# ─────────────────────────────────────────
# NutriDesk — Environment Variables
# ─────────────────────────────────────────
# Copy this file to:
#   apps/api/.env
#   apps/web/.env.local
# And fill in the values.

# ─── Supabase ────────────────────────────
# From: https://app.supabase.com → Project → Settings → API

# For the API (server-side, secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# For the Web app (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Anthropic / Claude ──────────────────
# From: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ─── API URL ─────────────────────────────
# URL where the API is running
# Development: http://localhost:3001
# Production: https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# ─── CORS ────────────────────────────────
# Origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:3000

# ─── Server ──────────────────────────────
PORT=3001
NODE_ENV=development
