# ─────────────────────────────────────────
# NutriDesk — Environment Variables
# ─────────────────────────────────────────
# Copy this file to:
#   apps/api/.env
#   apps/web/.env.local
# And fill in the values.

# ─── Supabase ────────────────────────────
# From: https://app.supabase.com → Project → Settings → API

# For the API (server-side, secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# For the Web app (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Anthropic / Claude ──────────────────
# From: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ─── API URL ─────────────────────────────
# URL where the API is running
# Development: http://localhost:3001
# Production: https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# ─── CORS ────────────────────────────────
# Origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:3000

# ─── Server ──────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Stripe ──────────────────────────────
# From: https://dashboard.stripe.com → Developers → API Keys
# Use test keys (sk_test_...) in development, live keys (sk_live_...) in production.
STRIPE_SECRET_KEY=sk_test_your_key_here

# From: https://dashboard.stripe.com → Developers → Webhooks → Add endpoint
# Endpoint URL: https://api.your-domain.com/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Public URL of the web app (used to build success/cancel redirect URLs)
WEB_URL=http://localhost:3000

# ─── Stripe Price IDs ────────────────────
# Create these products in: https://dashboard.stripe.com → Products
#
# Individual Pro Monthly  — €19.00 / month  (recurring)
STRIPE_PRICE_PRO_MONTHLY=price_your_id_here
#
# Individual Pro Annual   — €190.00 / year  (recurring)
STRIPE_PRICE_PRO_ANNUAL=price_your_id_here
#
# Enterprise Monthly      — €15.00 / month per seat  (recurring, per-seat)
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_your_id_here
#
# Enterprise Annual       — €12.00 / month per seat, billed yearly (recurring, per-seat)
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_your_id_here
